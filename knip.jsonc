{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/client": {
      // Bancos de pruebas del render y del audio: son puntos de entrada de sus
      // paginas `*-preview.html`, no codigo muerto.
      "entry": [
        "src/aa-preview.ts",
        "src/audio-preview.ts",
        "src/avatar-preview.ts",
        "src/world-preview.ts",
      ],
    },
  },
  "rules": {
    // `DEFAULT_MAP` es a proposito un alias de `ATRIUM`: el cliente arranca en
    // el mapa por defecto sin tener que saber cual es.
    "duplicates": "off",
  },
}
