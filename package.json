{
  "name": "neonduel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NEONDUEL - Arena shooter 1v1 online con movilidad estilo CS2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=@neonduel/server",
    "dev:client": "npm run dev --workspace=@neonduel/client",
    "build": "npm run build --workspace=@neonduel/client && npm run build --workspace=@neonduel/server",
    "start": "node apps/server/dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --force",
    "lint": "eslint . && prettier --check . && knip",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
