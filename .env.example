# Copia este archivo a `.env` si necesitas cambiar algo. Sin el, el juego escucha
# en 127.0.0.1:8090 y solo lo alcanza lo que corra en la propia maquina: un tunel
# de Cloudflare, un nginx, un ssh -L.

# Interfaz y puerto del host. Cambia el puerto si el 8090 ya esta ocupado.
# PUBLISH=127.0.0.1:8090

# Sin nada delante: publicalo en el 80 de la maquina (necesita el puerto abierto
# en la lista de seguridad de Oracle).
# PUBLISH=0.0.0.0:80
